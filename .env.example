# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env никогда не попадает в git.

# Токен Telegram-бота от @BotFather
BOT_TOKEN=ваш_токен_бота

# Дефолтный пароль для регистрации аккаунтов
DEFAULT_REG_PASSWORD=AutoPass123

# Сколько аккаунтов регистрировать параллельно
MAX_CONCURRENT_WORKERS=2

# Путь к папке с Minecraft
MINECRAFT_DIR=C:\\Users\\User\\Desktop\\AutoAccout\\minecraft-client

# Версия клиента
MINECRAFT_VERSION=1.21.4

# Игровой сервер FunTime
SERVER=mc.funtime.su:25565

# Необязательно: файлы с прокси (через запятую).
# По умолчанию используются proxy/proxies.txt и файлы из Downloads.
# PROXY_FILES=C:\\path\\to\\proxies.txt
